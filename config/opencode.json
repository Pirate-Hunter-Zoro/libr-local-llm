{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/qwen3-coder:30b",
  "default_agent": "coder",
  "enabled_providers": ["ollama"],
  "permission": {
    "webfetch": "deny",
    "websearch": "deny"
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (LIBR local)",
      "options": {
        "baseURL": "http://127.0.0.1:11500/v1"
      },
      "models": {
        "qwen3-coder:30b": {
          "name": "Qwen3-Coder 30B-A3B (default coder)"
        },
        "medgemma:27b-it-q8_0": {
          "name": "MedGemma 27B q8_0 (clinical)"
        },
        "gpt-oss:120b": {
          "name": "GPT-OSS 120B (c3_accel, 4 GPU)"
        }
      }
    }
  },
  "agent": {
    "coder": {
      "mode": "primary",
      "description": "Non-PHI coding work. Web tools gated behind an explicit prompt.",
      "model": "ollama/qwen3-coder:30b",
      "permission": {
        "webfetch": "ask",
        "websearch": "ask"
      }
    }
  }
}
