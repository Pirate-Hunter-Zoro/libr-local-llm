#!/bin/bash
# Launch opencode (or fire a one-shot prompt) against the running Ollama server,
# from anywhere -- including the login node.
#
# The endpoint is loopback-only on the serving node, so the client has to run
# there too. This uses `srun --overlap` to step into the existing allocation
# rather than ssh: no key needed, and it lands inside the job with the right
# CUDA_VISIBLE_DEVICES already set.
#
#   ollama-code                          # TUI in the current directory
#   ollama-code -d ~/proj                # TUI in another directory
#   ollama-code "explain this repo"      # one-shot prompt, no TUI
#   ollama-code -m gpt-oss:120b "hi"     # pick the model explicitly
#   ollama-code -k 2h                    # warm with a 2h hold and exit (pre-demo)
#   ollama-code -l                       # list this directory's past sessions
#   ollama-code -c                       # resume the most recent session here
#   ollama-code -s ses_abc123            # resume one session by id
#
# Session selection exists here because bare `opencode -s <id>` is the trap it
# looks like the cure for: the session store is fine, the endpoint is not. Both
# live under ~/.local/share/opencode on NFS home, mounted on every node, so a
# session started on one node is fully readable from the next -- but the client
# still has to run beside the loopback socket, which is what this script does.
# opencode scopes its session list to the PROJECT DIRECTORY, so -l and the TUI's
# own picker show only sessions belonging to -d (default: the current directory).
#
# With no -m, the model already resident on the GPU is used. That is deliberate:
# OLLAMA_MAX_LOADED_MODELS is 1, so naming a different model silently evicts the
# warm one and pays the multi-minute reload -- which is exactly what you do not
# want to discover in front of an audience.
set -euo pipefail

# Step onto the server's node. The SLURM_* scrub is load-bearing: if this is run
# from inside another allocation -- a VSCode remote session on a compute node,
# an interactive srun -- the nested srun inherits the OUTER job's SLURM_JOB_ID
# and step context and dies with exit 192, even though --jobid names a different
# job explicitly. Clearing the inherited variables makes it behave like a call
# from the login node.
srun_on_server() {
    (
        for v in $(env | grep -oE '^SLURM_[A-Z_0-9]+' || true); do unset "$v"; done
        exec srun --jobid="$JOB_ID" --overlap "$@"
    )
}

MODEL=""
WORKDIR="$PWD"
KEEPALIVE=""
PROFILE=""
SESSION=""
CONTINUE=""
LIST_SESSIONS=""

while [ $# -gt 0 ]; do
    case "$1" in
        -m|--model)     MODEL="$2"; shift 2 ;;
        -d|--dir)       WORKDIR="$2"; shift 2 ;;
        -k|--keepalive) KEEPALIVE="$2"; shift 2 ;;
        -p|--profile)   PROFILE="$2"; shift 2 ;;
        -s|--session)   SESSION="$2"; shift 2 ;;
        -c|--continue)  CONTINUE=1; shift ;;
        -l|--list-sessions) LIST_SESSIONS=1; shift ;;
        -h|--help)
            echo "usage: ollama-code [-m model] [-d dir] [-k duration] [-p single|accel]"
            echo "                   [-s session-id | -c] [-l] [message...]"
            echo
            echo "  -s, --session        resume this session id"
            echo "  -c, --continue       resume the most recent session in -d"
            echo "  -l, --list-sessions  list sessions in -d and exit (no server needed)"
            exit 0
            ;;
        --) shift; break ;;
        *) break ;;
    esac
done
MESSAGE="$*"

# Listing sessions needs no model and no node: the store is on NFS home and only
# the project directory scopes the list. Answer it here and stop, so this works
# with nothing running at all -- which is when you most want to know what is
# there. A login shell is used so nvm's PATH (and therefore opencode) exists;
# `session` is on the opencode guard's passthrough list, so the function in
# ~/.bashrc hands it straight to the real binary.
if [ -n "$LIST_SESSIONS" ]; then
    echo "Sessions in ${WORKDIR}:" >&2
    exec bash -lc "cd $(printf '%q' "$WORKDIR"); opencode session list"
fi

if [ -n "$SESSION" ] && [ -n "$CONTINUE" ]; then
    echo "-s and -c both choose a session; pass one or the other." >&2
    exit 2
fi

# Find the server. Ask Slurm rather than reading a state file: a state file goes
# stale the moment a job ends, squeue never does.
#
# Both profiles can be up at once, in which case accel wins by default -- it is
# the one you went out of your way to start. Use -p to name the other.
case "$PROFILE" in
    "")      SEARCH="ollama_serve_accel ollama_serve" ;;
    accel)   SEARCH="ollama_serve_accel" ;;
    single)  SEARCH="ollama_serve" ;;
    *) echo "usage: -p takes 'single' or 'accel'" >&2; exit 2 ;;
esac

JOB_ID=""
for NAME in $SEARCH; do
    JOB_ID="$(squeue -u "$USER" -n "$NAME" -t RUNNING -h -o '%i' | head -1)"
    [ -n "$JOB_ID" ] && { JOB_NAME="$NAME"; break; }
done

if [ -z "$JOB_ID" ]; then
    echo "No matching Ollama server is running. Start one with:" >&2
    echo "    ollama-up          (1 GPU, c3_short)" >&2
    echo "    ollama-up accel    (4 GPUs, c3_accel -- gpt-oss:120b)" >&2
    exit 1
fi

# With two servers up, say which one this is talking to. Guessing wrong here
# means loading a 65 GB model onto the wrong node.
OTHER="$(squeue -u "$USER" -n ollama_serve,ollama_serve_accel -t RUNNING -h -o '%i' | wc -l)"
[ "$OTHER" -gt 1 ] && [ -z "$PROFILE" ] && \
    echo "(two servers up; using ${JOB_NAME}. Use -p single|accel to choose.)" >&2

NODE="$(squeue -j "$JOB_ID" -h -o '%N')"
echo "Using ${JOB_NAME} job ${JOB_ID} on ${NODE}" >&2

# With no explicit model, adopt whatever is already resident.
if [ -z "$MODEL" ]; then
    MODEL="$(srun_on_server --quiet \
        bash -lc 'source ~/.bashrc >/dev/null 2>&1; ollama ps' 2>/dev/null \
        | awk 'NR==2 {print $1}')"
    if [ -n "$MODEL" ]; then
        echo "Adopting resident model: ${MODEL}" >&2
    else
        MODEL="qwen3-coder:30b"
        [ "$JOB_NAME" = "ollama_serve_accel" ] && MODEL="gpt-oss:120b"
        echo "Nothing resident; will load ${MODEL} (first load is slow)" >&2
    fi
fi

# Session flags are forwarded verbatim to opencode on the far node. The
# invocation crosses a `bash -lc` string boundary, so everything interpolated
# into it is quoted with printf %q: the far side is the same bash, so %q
# round-trips exactly, and a directory or prompt containing a quote stops being
# able to break the command apart.
OC_ARGS=()
[ -n "$SESSION" ]  && OC_ARGS+=(--session "$SESSION")
[ -n "$CONTINUE" ] && OC_ARGS+=(--continue)

# Resuming is the one case where -m is not the last word. Verified by launching
# the TUI on the node with --print-logs against a session whose history was
# qwen3-coder: the footer opened on the model -m named, then switched to the
# session's own model once the history replayed. So a resumed session can carry a
# model choice of its own, and on the accel profile that means the 70 GB
# resident model is evicted the moment the first message is sent. Say so rather
# than discovering it as a multi-minute stall.
if { [ -n "$SESSION" ] || [ -n "$CONTINUE" ]; } && [ "$JOB_NAME" = "ollama_serve_accel" ]; then
    echo "Note: a resumed session may carry its own model. If that model is not" >&2
    echo "      ${MODEL}, the first message evicts it and reloads from scratch." >&2
    echo "      Check the model shown in the TUI footer before sending." >&2
fi

Q_WORKDIR="$(printf '%q' "$WORKDIR")"
Q_OC=""
# Guarded on the count because printf runs its format once even with no
# arguments, which would otherwise inject an empty quoted string.
[ "${#OC_ARGS[@]}" -gt 0 ] && Q_OC="$(printf '%q ' "${OC_ARGS[@]}")"

# Optional pre-warm. --keepalive is PER REQUEST: every later call that omits it
# -- and opencode omits it on every call -- resets the hold to OLLAMA_KEEP_ALIVE
# (20m). Use this before a demo so the load cost is paid up front.
if [ -n "$KEEPALIVE" ]; then
    echo "Warming ${MODEL} with a ${KEEPALIVE} hold..." >&2
    srun_on_server --quiet bash -lc \
        "source ~/.bashrc; ollama run --keepalive '${KEEPALIVE}' --hidethinking '${MODEL}' 'Reply with exactly: OK'" \
        >/dev/null 2>&1
    srun_on_server --quiet bash -lc 'source ~/.bashrc; ollama ps' >&2
    # Warming is a standalone act: stop here rather than dropping into the TUI,
    # so this is safe to run from a script or a non-interactive shell.
    [ -z "$MESSAGE" ] && exit 0
fi

if [ -n "$MESSAGE" ]; then
    # One-shot. No TUI, so no pty needed.
    srun_on_server --quiet bash -lc \
        "source ~/.bashrc; cd ${Q_WORKDIR}; opencode run -m $(printf '%q' "ollama/${MODEL}") ${Q_OC}-- $(printf '%q' "${MESSAGE}")"
else
    # TUI. --pty is what makes the terminal interactive through Slurm.
    #
    # The model is passed here too, which it did not used to be. opencode's
    # default (TUI) command does accept --model as of 1.18.x, and without it the
    # TUI takes config/opencode.json's default -- qwen3-coder:30b. On the accel
    # server that is an eviction: OLLAMA_MAX_LOADED_MODELS is 1, so opening the
    # TUI beside a resident gpt-oss:120b would unload 70 GB and reload from
    # scratch, which is the exact failure the resident-model adoption above
    # exists to prevent. Passing it makes the TUI agree with the one-shot path.
    srun_on_server --quiet --pty bash -lc \
        "source ~/.bashrc; cd ${Q_WORKDIR}; opencode -m $(printf '%q' "ollama/${MODEL}") ${Q_OC}"
fi
